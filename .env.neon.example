# このファイルをルートの .env.neon.local にコピーして設定する。
# NeonのConnect画面でPoC用ブランチ・DB・管理用ロールを選択する。
# DATABASE_URL_UNPOOLEDの値（-poolerのない直接接続URL）を設定する。
# 各値を引用符で囲まない（Composeのraw形式でそのまま読み込む）。
DATABASE_URL_DIRECT=

# URLのコピー間違いを検出するため、接続予定のホスト名・DB名を別途指定する。
# ホスト名にはポートや https:// を含めない。DB名はURLデコード後の名前。
NEON_EXPECTED_HOST=
NEON_EXPECTED_DATABASE=
